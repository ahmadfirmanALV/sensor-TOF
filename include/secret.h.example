#pragma once

// Salin file ini menjadi include/secret.h lalu sesuaikan dengan kredensial Anda.
// File include/secret.h tidak akan disimpan ke Git (.gitignore).

// ==============================================================================
// 1. Konfigurasi WiFi Default / Cadangan (Opsional)
// ==============================================================================
// Jika dikosongkan (""), firmware akan mengandalkan WiFiManager untuk memindai
// dan menghubungkan ke jaringan melalui Web Captive Portal.
// #define DEFAULT_WIFI_SSID "nama_wifi"
// #define DEFAULT_WIFI_PASSWORD "kata_sandi_wifi"

// ==============================================================================
// 2. Konfigurasi WiFiManager Captive Portal
// ==============================================================================
#define WIFIMANAGER_AP_NAME "ESP32-RoomCounter-AP"
#define WIFIMANAGER_AP_PASSWORD "12345678" // Minimal 8 karakter, atau "" untuk open AP
#define WIFIMANAGER_PORTAL_TIMEOUT_SEC 120 // Batas waktu portal (detik) sebelum mode offline

// ==============================================================================
// 3. Konfigurasi ThingSpeak IoT Cloud
// ==============================================================================
// Ganti dengan Channel ID dan Write API Key dari ThingSpeak Anda.
// Nilai ini juga dapat diubah melalui Captive Portal WiFiManager tanpa flash ulang.
#define THINGSPEAK_CHANNEL_ID 0UL                 // Contoh: 1234567UL (0 = belum dikonfigurasi)
#define THINGSPEAK_WRITE_API_KEY "YOUR_API_KEY"   // Kunci API Tulis ThingSpeak (16 karakter)
#define THINGSPEAK_UPDATE_INTERVAL_MS 20000       // Interval kirim berkala (minimal 15000 ms)
